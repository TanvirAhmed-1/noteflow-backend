NODE_ENV=development
PORT=5000

# MongoDB Connection String
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/note_taking_app?retryWrites=true&w=majority

# Security & Password Hashing
BCRYPT_SALT_ROUNDS=10

# JWT Secrets & Expiry
TOKEN_SECRET_KEY=your_super_secret_jwt_access_token_key
TOKEN_EXPIRES_IN=7d
REFRESHTOKEN_SECRET_KEY=your_super_secret_jwt_refresh_token_key
REFRESHTOKEN_EXPIRES_IN=14d



# CORS Allowed Origin
FRONTEND_URL=http://localhost:3000

# Automatic Admin Seed Configuration (Created automatically on server startup if not present)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=your_admin_password

