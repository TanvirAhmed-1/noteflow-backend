    {
      "name": "2. Interview Scenarios (MongoDB Aggregations)",
      "item": [
        {
          "name": "Scenario 1: Group Users by Interests (Single aggregate pipeline)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/grouped-by-interests?page=1&limit=10&minUsers=1",
              "host": ["{{baseUrl}}"],
              "path": ["users", "grouped-by-interests"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "minUsers",
                  "value": "1",
                  "description": "Filters interest groups having at least X members"
                },
                {
                  "key": "searchInterest",
                  "value": "Coding",
                  "disabled": true
                }
              ]
            },
            "description": "Executes Scenario 1 using a single UserModel.aggregate() pipeline with $match, $unwind, $group, $sort, and $facet for pagination & summary totals."
          }
        },
        {
          "name": "Scenario 2: Retrieve User Posts with $lookup Pipeline",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/user/{{userId}}?type=all&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "user", "{{userId}}"],
              "query": [
                {
                  "key": "type",
                  "value": "all",
                  "description": "Options: 'all', 'community', 'personal'"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Executes Scenario 2: retrieves user posts utilizing a MongoDB $lookup aggregation stage to join user details and return posts array."
          }
        },
        {
          "name": "Scenario 2 (Alternate Endpoint): /users/:userId/posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/posts?type=community",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "posts"],
              "query": [
                {
                  "key": "type",
                  "value": "community"
                }
              ]
            },
            "description": "Alternate RESTful URL pattern for retrieving user posts using the $lookup stage."
          }
        },
        {
          "name": "Admin Unified Feed ($unionWith + $lookup)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/admin-table?page=1&limit=10&type=all&interest=Coding",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "admin-table"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "type",
                  "value": "all",
                  "description": "'all', 'community' (Public), or 'personal' (Private)"
                },
                {
                  "key": "interest",
                  "value": "Coding"
                },
                {
                  "key": "userName",
                  "value": "Tanvir",
                  "disabled": true
                }
              ]
            },
            "description": "Unified admin table pipeline combining posts and notes collections via $unionWith and resolving author data via $lookup."
          }
        }
      ]
    },
