    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Regular User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tanvir Ahmed\",\n  \"email\": \"tanvir.user@example.com\",\n  \"password\": \"User@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": ["{{baseUrl}}"],
              "path": ["register"]
            },
            "description": "Registers a new user and returns JWT accessToken with role: 'user'."
          }
        },
        {
          "name": "Login Regular User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.result && res.result.accessToken) {",
                  "    pm.collectionVariables.set('userToken', res.result.accessToken);",
                  "    if (res.result.user && res.result.user._id) {",
                  "        pm.collectionVariables.set('userId', res.result.user._id);",
                  "    }",
                  "    console.log('Saved userToken successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tanvir.user@example.com\",\n  \"password\": \"User@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            },
            "description": "Logs in user and automatically populates {{userToken}} and {{userId}} variables."
          }
        },
        {
          "name": "Login Seeded Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.result && res.result.accessToken) {",
                  "    pm.collectionVariables.set('adminToken', res.result.accessToken);",
                  "    console.log('Saved adminToken successfully');",
                  "}"
